{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "endOfLine": "lf",
  "arrowParens": "always",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["parent", "sibling", "index"],
      ["side_effect", "side_effect_style", "style"],
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "apps/docs/**/*.mdx",
    "apps/docs/docs.json",
    "dist/",
    "node_modules/",
    "packages/webfuscator/tests/fixtures/"
  ]
}
