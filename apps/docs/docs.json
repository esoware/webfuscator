        "type": "github",
        "href": "https://github.com/esoware/webfuscator"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View on npm",
      "href": "https://www.npmjs.com/package/webfuscator"
    }
  },
  "footer": {
