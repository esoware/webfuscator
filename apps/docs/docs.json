{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "webfuscator",
  "description": "Documentation for webfuscator, a JavaScript obfuscator built on Babel.",
  "logo": {
    "light": "/logo/wordmark-light.svg",
    "dark": "/logo/wordmark.svg"
  },
  "colors": {
    "primary": "#1D4ED8",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0F0F0F"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "getting-started/quickstart", "guides/configure-transforms"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/api",
          "reference/options",
          "reference/property-mangling-options",
          "reference/string-generator-modes",
          {
            "group": "Removal transforms",
            "pages": [
              "reference/transforms/drop-console",
              "reference/transforms/drop-debugger",
              "reference/transforms/remove-unreachable-code",
              "reference/transforms/remove-unused-code",
              "reference/transforms/remove-anonymous-function-names"
            ]
          },
          {
            "group": "Simplification and inlining",
            "pages": [
              "reference/transforms/arguments-to-parameters",
              "reference/transforms/fold-constants",
              "reference/transforms/fold-builtin-methods",
              "reference/transforms/extract-object-properties",
              "reference/transforms/inline-functions",
              "reference/transforms/collapse-single-use-temps"
            ]
          },
          {
            "group": "Declarations and functions",
            "pages": [
              "reference/transforms/const-to-let",
              "reference/transforms/const-let-to-var",
              "reference/transforms/object-method-to-property",
              "reference/transforms/arrow-to-function",
              "reference/transforms/function-declaration-to-expression",
              "reference/transforms/pack-declarations-into-parameters"
            ]
          },
          {
            "group": "Control flow",
            "pages": [
              "reference/transforms/switch-to-if",
              "reference/transforms/for-to-while",
              "reference/transforms/do-while-to-while",
              "reference/transforms/optional-chaining-to-ternary",
              "reference/transforms/nullish-coalescing-to-ternary",
              "reference/transforms/logical-to-ternary",
              "reference/transforms/ternary-to-if"
            ]
          },
          {
            "group": "Expression transforms",
            "pages": [
              "reference/transforms/update-to-assignment",
              "reference/transforms/expand-binary-assignment",
              "reference/transforms/expand-logical-assignment",
              "reference/transforms/yodify-conditions"
            ]
          },
          {
            "group": "Names and literals",
            "pages": [
              "reference/transforms/specials-to-strings",
              "reference/transforms/numbers-to-strings",
              "reference/transforms/mangle-properties",
              "reference/transforms/rename-identifiers"
            ]
          },
          {
            "group": "Packing",
            "pages": ["reference/transforms/pack"]
          }
        ]
      },
      {
        "group": "Support",
        "pages": ["troubleshooting/report-a-bug"]
      }
    ]
  },
  "interaction": {
    "drilldown": false
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "icon": "play",
        "href": "https://playground.webfuscator.dev"
      },
