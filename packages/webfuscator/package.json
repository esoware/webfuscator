{
  "name": "webfuscator",
  "version": "1.0.0",
  "description": "JavaScript obfuscator built on Babel",
  "keywords": [
    "babel",
    "code-protection",
    "javascript",
    "mangler",
    "minifier",
    "obfuscation",
    "obfuscator"
  ],
  "homepage": "https://github.com/esoware/webfuscator#readme",
  "bugs": {
    "url": "https://github.com/esoware/webfuscator/issues"
  },
  "license": "MIT",
  "author": "Esoware",
  "contentPolicy": {
    "class": "dual-use"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esoware/webfuscator.git",
    "directory": "packages/webfuscator"
  },
  "files": [
    "DISCLOSURE",
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm --workspace-root check",
    "prepack": "pnpm run build",
    "build": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
