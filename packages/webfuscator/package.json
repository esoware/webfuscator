{
  "name": "webfuscator",
  "version": "1.3.2",
  "description": "JavaScript obfuscator built on Babel",
  "keywords": [
    "babel",
    "code-protection",
    "javascript",
    "mangler",
    "minifier",
    "obfuscation",
    "obfuscator"
  ],
  "homepage": "https://github.com/esoware/webfuscator#readme",
  "bugs": {
    "url": "https://github.com/esoware/webfuscator/issues"
  },
  "license": "MIT",
  "author": "Esoware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esoware/webfuscator.git",
    "directory": "packages/webfuscator"
  },
  "files": [
    "DISCLOSURE",
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node scripts/reject-source-package.mjs",
    "prepack": "node scripts/reject-source-package.mjs",
    "build": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "package:pack": "pnpm run build && pnpm run package:stage && node scripts/pack-package.mjs && pnpm run package:verify",
    "package:stage": "node scripts/stage-package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsc-alias": "^1.9.2",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "contentPolicy": {
    "class": "dual-use"
  }
}
