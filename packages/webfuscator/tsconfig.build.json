{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "isolatedDeclarations": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*"],

  // Node cannot resolve an extensionless ESM specifier and tsc emits relative
  // imports verbatim, so this adds the extensions and `src` keeps writing plain
  // relative paths. `scripts/verify-dist.mjs` fails the build if any survive.
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
