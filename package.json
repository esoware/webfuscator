{
  "name": "@webfuscator/monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm run test",
    "docs:check": "pnpm --filter @webfuscator/docs run check",
    "docs:dev": "pnpm --filter @webfuscator/docs run dev",
    "docs:format": "pnpm --filter @webfuscator/docs run format",
    "docs:generate": "pnpm --filter @webfuscator/docs run generate",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
