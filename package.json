{
  "name": "@webfuscator/monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm --filter @webfuscator/docs run generate:check && pnpm run test",
    "deploy:playground": "pnpm --filter @webfuscator/playground run deploy",
    "dev": "pnpm --filter @webfuscator/playground run dev",
    "docs:check": "pnpm --filter @webfuscator/docs run check",
    "docs:dev": "pnpm --filter @webfuscator/docs run dev",
    "docs:format": "pnpm --filter @webfuscator/docs run format",
    "docs:generate": "pnpm --filter @webfuscator/docs run generate",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "package:pack": "pnpm --filter webfuscator run package:pack",
    "package:stage": "pnpm --filter webfuscator run package:stage",
    "package:verify": "pnpm --filter webfuscator run package:verify",
    "preview": "pnpm --filter @webfuscator/playground run preview",
    "test": "pnpm --recursive --if-present run test",
    "test:watch": "pnpm --filter webfuscator run test:watch",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "knip": "^6.32.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
